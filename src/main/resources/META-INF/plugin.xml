<idea-plugin>
    <id>com.olicoder.plugin</id>
    <name>Oli Coder</name>
    <vendor email="you@example.com" url="https://example.com">YourName</vendor>

    <description><![CDATA[
        一个多模型 AI 编程助手：用户自选厂商（OpenAI 兼容协议 / Anthropic / Gemini），
        自填 Base URL 和 API Key，本地加密存储 Key，不经过任何第三方服务器中转。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 应用级设置持久化 -->
        <applicationService serviceImplementation="com.olicoder.plugin.settings.OliCoderSettingsState"/>

        <!-- 设置页：Settings/Preferences -> Tools -> Oli Coder -->
        <applicationConfigurable
                parentId="tools"
                instance="com.olicoder.plugin.settings.OliCoderSettingsConfigurable"
                id="com.olicoder.plugin.settings.OliCoderSettingsConfigurable"
                displayName="Oli Coder"/>

        <!-- 右侧/底部工具窗口：聊天面板 -->
        <toolWindow
                id="Oli Coder"
                anchor="right"
                factoryClass="com.olicoder.plugin.toolwindow.ChatToolWindowFactory"
                icon="/icons/olicoder.svg"/>
    </extensions>

    <actions>
        <action id="com.olicoder.plugin.actions.SendSelectionToChatAction"
                class="com.olicoder.plugin.actions.SendSelectionToChatAction"
                text="发送选中代码到 AI 对话"
                description="把当前选中的代码发送到 Oli Coder 对话窗口">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
